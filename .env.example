# Copy this file to .env and replace the placeholders before starting.

# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-a-random-secret

ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-unique-password

# Comma-separated frontend origins.
ALLOWED_ORIGINS=http://localhost:5173

SESSION_HOURS=8
MAX_PHOTO_BYTES=5242880
SEED_DEMO=false
ID_PREFIX=JT
PORT=8000

# Cloudinary is required for photo uploads.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional: PostgreSQL connection URL. SQLite is used by default.
# DATABASE_URL=
